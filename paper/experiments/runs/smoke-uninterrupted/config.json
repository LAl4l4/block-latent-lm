{
  "name": "smoke",
  "model": {
    "chunk_size": 4,
    "encoder_dim": 32,
    "dim": 64,
    "layers": 2,
    "heads": 4,
    "ff_dim": 192,
    "decoder_dim": 32,
    "decoder_layers": 2,
    "decoder_heads": 2,
    "decoder_ff_dim": 96
  },
  "training": {
    "seed": 42,
    "precision": "bf16",
    "cpu_threads": 4,
    "train_limit": 1000,
    "batch_size": 2,
    "grad_accum": 1,
    "min_prompt_tokens": 5,
    "max_prompt_tokens": 32,
    "max_target_tokens": 64,
    "max_steps": 4,
    "learning_rate": 0.0003,
    "min_lr_ratio": 0.1,
    "warmup_steps": 1,
    "weight_decay": 0.1,
    "grad_clip": 1.0,
    "log_every": 1,
    "eval_every": 2,
    "eval_batches": 2,
    "save_every": 2
  },
  "ablation": "full"
}
