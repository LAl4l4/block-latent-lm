{
  "name": "calm-16",
  "vae_checkpoint": "runs/vae-16/last.pt",
  "quality_gate": {
    "token_accuracy": 0.99, "block_accuracy": 0.88, "eval_blocks": 2048
  },
  "model": {
    "chunk_size": 16, "dim": 512,
    "layers": 8, "heads": 8, "ff_dim": 1536,
    "noise_dim": 64, "energy_candidates": 8,
    "target_samples": 100, "energy_layers": 4,
    "energy_batch_blocks": 32
  },
  "training": {
    "seed": 42, "precision": "bf16", "cpu_threads": 4,
    "batch_size": 128, "grad_accum": 2,
    "min_prompt_tokens": 16, "max_prompt_tokens": 128, "max_target_tokens": 64,
    "max_steps": 10000, "learning_rate": 0.0003,
    "lr_schedule": "constant", "warmup_steps": 100,
    "min_lr_ratio": 1.0, "weight_decay": 0.1, "grad_clip": 1.0,
    "log_every": 10, "eval_every": 250,
    "eval_batches": 4, "eval_batch_size": 16, "save_every": 100
  }
}
